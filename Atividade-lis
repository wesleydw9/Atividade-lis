def lis(sequencia):
    n = len(sequencia)

    if n == 0:
        return 0

    dp = [1] * n

    for i in range(1, n):
        for j in range(i):
            if sequencia[j] < sequencia[i]:
                dp[i] = max(dp[i], dp[j] + 1)

    return max(dp)


sequencia = [10, 22, 9, 33, 21, 50, 41, 60]

resultado = lis(sequencia)

print("Tamanho da maior subsequencia crescente:", resultado)
